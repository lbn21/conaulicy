# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# drawn from lib/palette.ts by scripts/brand-assets.ts
/app/_palette.scss
/app/icon.svg
/app/favicon.ico
/app/apple-icon.png
/public/icon-192.png
/public/icon-512.png
/public/icon-maskable-512.png
/public/og.png
/.brand-assets-key
