# Environment variables read by the app and its scripts (names only, no values).
# Copy to .env.local and fill in what you need. Never point it at production.

# Site and database
# Postgres connection string: a throwaway local database (docs/database.md).
DATABASE_URL=
# Direct (unpooled) connection for migrations and scripts; falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=
# Optional: "user:password" for the pre-launch HTTP Basic Auth gate; unset = site open.
SITE_BASIC_AUTH=
# Optional: bearer token that POST /api/revalidate accepts and the import sends.
REVALIDATE_SECRET=

# Import and data scripts (docs/import.md)
# Database the import writes to; takes precedence over DATABASE_URL_UNPOOLED and DATABASE_URL.
IMPORT_DATABASE_URL=
# xAI key: Grok reads the water posts and the import's waste schedules.
# Only inside Actions for the import (docs/import.md).
XAI_API_KEY=
# GitHub token: when set, review PRs and issues are opened on GitHub.
GH_TOKEN=
# Site whose cache an import refreshes; defaults to site.url in etl/sources.yaml.
SITE_URL=
# Vercel deployment protection bypass sent with revalidate and site requests.
VERCEL_AUTOMATION_BYPASS_SECRET=
# Path to an alternative sources config; defaults to etl/sources.yaml.
IMPORT_CONFIG=
# Date the import treats as "now" (ISO 8601); defaults to the current time.
IMPORT_NOW=
# Directory for review files; defaults to etl/review.
IMPORT_REVIEW_DIR=
# Local directory to archive fetched sources to instead of S3.
ARCHIVE_DIR=
# Write review PRs to this JSON file instead of GitHub.
REVIEWS_FILE=
# Write issues to this JSON file instead of GitHub.
ISSUES_FILE=
# Link to the CI run, added to issues and import records.
ACTIONS_RUN_URL=

# Checks and tests (web/scripts/check-*.mjs)
# Check a running site at this URL instead of starting a local one (check:examples).
CHECK_URL=
# "1" to validate HTML with validator.w3.org/nu instead of local Java (check:html).
HTML_CHECK_REMOTE=
# Directory for screenshots of every place page (check:all-places).
SCREENSHOT_DIR=
# Number of Lighthouse runs per page (check:perf); defaults to 5.
PERF_RUNS=
# File to write the perf results JSON to (check:perf).
PERF_OUT=
# Tests only: directory of canned Grok replies for the waste import, instead of xAI.
XAI_MOCK_DIR=
# Tests only: regex of the query before which the connection is dropped.
DROP_QUERY=
# Tests only: how many times to drop it; defaults to always.
DROP_TIMES=
