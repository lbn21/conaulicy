{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "budget": "node scripts/check-bundle.mjs",
    "check:html": "next build && node scripts/check-html.mjs",
    "check:a11y": "next build && node scripts/check-a11y.mjs",
    "check:examples": "next build && node scripts/check-examples.mjs",
    "check:all-places": "next build && node scripts/check-all-places.mjs",
    "check:pdf": "next build && node scripts/check-pdf.mjs",
    "sources:pull": "node scripts/sources-pull.ts",
    "config:sync": "node scripts/config-sync.ts",
    "zuk:places": "node scripts/zuk-places-snapshot.ts",
    "prg:update": "node scripts/prg-update.ts",
    "config:check": "node scripts/config-sync.ts --check",
    "check:metadata": "next build && node scripts/check-metadata.mjs",
    "check:perf": "next build && node scripts/check-perf.mjs",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "check:unused": "knip",
    "check:dupes": "jscpd --min-tokens 50 --cross-formats js-ts --exit-code --format typescript,tsx,javascript,scss --ignore \"**/drizzle/**,lib/config.generated.ts\" .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:ci-fixture": "node --env-file-if-exists=.env.local scripts/ci-fixture.ts",
    "db:local": "node scripts/db-local.ts",
    "db:local:reset": "node scripts/db-local.ts reset",
    "db:local:stop": "node scripts/db-local.ts stop",
    "db:import": "node --env-file-if-exists=.env.local scripts/import.ts",
    "db:redirect": "node --env-file-if-exists=.env.local scripts/place-redirect.ts",
    "db:districts": "node --env-file-if-exists=.env.local scripts/districts-seed.ts",
    "water:dry-run": "node --env-file-if-exists=.env.local --import ./scripts/lib/server-only.mjs scripts/water-dry-run.ts",
    "check:teryt": "node scripts/check-teryt.ts",
    "import:run": "node --env-file-if-exists=.env.local scripts/import/core/run.ts",
    "import:revert": "node --env-file-if-exists=.env.local scripts/import/core/revert.ts",
    "test": "node --import ./scripts/lib/no-network.mjs --import ./scripts/lib/server-only.mjs --import ./scripts/lib/tsx.mjs --test \"lib/**/*.test.ts\" \"scripts/**/*.test.ts\" \"components/**/*.test.ts\""
  },
  "dependencies": {
    "@leeoniya/ufuzzy": "1.0.19",
    "@neondatabase/serverless": "1.2.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/blob": "2.8.2",
    "accessible-autocomplete": "3.0.2",
    "drizzle-orm": "0.45.3",
    "govuk-frontend": "6.5.1",
    "next": "16.4.2",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "jscpd": "5.4.2",
    "knip": "6.43.0",
    "lighthouse": "13.5.0",
    "playwright": "1.64.1",
    "sass": "1.105.1",
    "typescript": "7.0.2",
    "vnu-jar": "26.10.12",
    "yaml": "2.9.1"
  }
}
