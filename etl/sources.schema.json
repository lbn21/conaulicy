{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "conaulicy.pl data configuration (etl/sources.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["site", "import", "domains", "archive", "sources", "archived"],
  "properties": {
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "features"],
      "properties": {
        "url": { "type": "string", "pattern": "^https://[^/]+$" },
        "features": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["section", "links"],
            "properties": {
              "section": { "type": "string", "minLength": 1 },
              "links": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["href", "text"],
                  "properties": {
                    "href": { "type": "string", "pattern": "^/" },
                    "text": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "import": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retries"],
      "properties": {
        "retries": {
          "type": "object",
          "additionalProperties": false,
          "required": ["attempts", "backoffSeconds"],
          "properties": {
            "attempts": { "type": "integer", "minimum": 1, "maximum": 10 },
            "backoffSeconds": { "type": "number", "minimum": 0, "maximum": 300 }
          }
        }
      }
    },
    "domains": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waste"],
      "properties": {
        "waste": {
          "type": "object",
          "additionalProperties": false,
          "required": ["validate", "coverageMinDays"],
          "properties": {
            "coverageMinDays": { "type": "integer", "minimum": 1, "maximum": 365 },
            "validate": {
              "type": "object",
              "additionalProperties": false,
              "required": ["weekdayShare", "holidayWindowDays", "counts"],
              "properties": {
                "weekdayShare": { "type": "number", "minimum": 0.5, "maximum": 1 },
                "holidayWindowDays": { "type": "integer", "minimum": 0, "maximum": 14 },
                "counts": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["factor", "slack", "minMonths"],
                  "properties": {
                    "factor": { "type": "number", "minimum": 0, "maximum": 1 },
                    "slack": { "type": "integer", "minimum": 0 },
                    "minMonths": { "type": "integer", "minimum": 1, "maximum": 12 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bucket", "region", "role"],
      "properties": {
        "bucket": { "type": "string", "pattern": "^[a-z0-9.-]{3,63}$" },
        "region": { "type": "string", "pattern": "^[a-z]{2}-[a-z]+-\\d$" },
        "role": { "type": "string", "pattern": "^arn:aws:iam::\\d{12}:role/[\\w+=,.@-]+$" }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "domain", "name", "origin", "page", "detect", "extract"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "domain": { "enum": ["waste"] },
          "name": { "type": "string", "minLength": 1 },
          "origin": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "page": { "type": "string", "pattern": "^(https://|http://127\\.0\\.0\\.1:\\d+/)" },
          "detect": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
              "type": { "enum": ["wp-media", "wp-post-files"] },
              "site": { "type": "string", "pattern": "^(https://[^/]+|http://127\\.0\\.0\\.1:\\d+)$" },
              "parent": { "type": "integer", "minimum": 1 },
              "postSearch": { "type": "string", "minLength": 1 },
              "postTitle": { "type": "string", "minLength": 1 },
              "file": { "type": "string", "minLength": 1 }
            }
          },
          "watch": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["url", "links"],
              "properties": {
                "url": { "type": "string", "pattern": "^(https://|http://127\\.0\\.0\\.1:\\d+/)" },
                "links": { "type": "string", "minLength": 1 },
                "ignore": { "type": "array", "items": { "type": "string", "pattern": "^(https://|http://127\\.0\\.0\\.1:\\d+/)" } }
              }
            }
          },
          "extract": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "layout"],
            "properties": {
              "type": { "enum": ["waste-ai"] },
              "layout": { "enum": ["gmina", "miasto"] }
            }
          },
          "waste": {
            "type": "object",
            "additionalProperties": false,
            "required": ["gmina", "zone", "validate"],
            "properties": {
              "gmina": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "teryt"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "teryt": { "type": "string", "pattern": "^\\d{7}$" }
                }
              },
              "zone": { "type": "string", "pattern": "\\{sector\\}" },
              "validate": {
                "type": "array",
                "items": { "enum": ["year", "weekday", "counts", "members"] }
              }
            }
          }
        }
      }
    },
    "archived": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "origin", "fetched", "sha256"],
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "origin": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "fetched": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "url": { "type": "string", "pattern": "^(https://|http://127\\.0\\.0\\.1:\\d+/)" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
