{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "conaulicy.pl data configuration (etl/sources.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["site", "schedule", "import", "domains", "vision", "archive", "sources", "archived"],
  "properties": {
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "features"],
      "properties": {
        "url": { "type": "string", "pattern": "^https://[^/]+$" },
        "features": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["section", "links"],
            "properties": {
              "section": { "type": "string", "minLength": 1 },
              "links": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["href", "text"],
                  "properties": {
                    "href": { "type": "string", "pattern": "^/" },
                    "text": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "time", "timezone"],
      "properties": {
        "enabled": { "type": "boolean" },
        "time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):00$" },
        "timezone": { "type": "string", "minLength": 1 }
      }
    },
    "import": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retries", "alerts"],
      "properties": {
        "retries": {
          "type": "object",
          "additionalProperties": false,
          "required": ["attempts", "backoffSeconds"],
          "properties": {
            "attempts": { "type": "integer", "minimum": 1, "maximum": 10 },
            "backoffSeconds": { "type": "number", "minimum": 0, "maximum": 300 }
          }
        },
        "alerts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["coverageMinDays"],
          "properties": {
            "coverageMinDays": { "type": "integer", "minimum": 1, "maximum": 365 }
          }
        }
      }
    },
    "domains": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waste"],
      "properties": {
        "waste": {
          "type": "object",
          "additionalProperties": false,
          "required": ["validate"],
          "properties": {
            "validate": {
              "type": "object",
              "additionalProperties": false,
              "required": ["weekdayShare", "holidayWindowDays", "counts"],
              "properties": {
                "weekdayShare": { "type": "number", "minimum": 0.5, "maximum": 1 },
                "holidayWindowDays": { "type": "integer", "minimum": 0, "maximum": 14 },
                "counts": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["factor", "slack", "minMonths"],
                  "properties": {
                    "factor": { "type": "number", "minimum": 0, "maximum": 1 },
                    "slack": { "type": "integer", "minimum": 0 },
                    "minMonths": { "type": "integer", "minimum": 1, "maximum": 12 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "vision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cli", "passes"],
      "properties": {
        "cli": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}-[0-9a-f]{7,}$" },
        "passes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "vendor", "model"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "vendor": { "enum": ["anthropic", "openai", "google", "xai"] },
              "model": { "type": "string", "pattern": "^(?!auto$)(?!.*-fast$)[a-z0-9.-]+$" }
            }
          }
        }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bucket", "region", "role"],
      "properties": {
        "bucket": { "type": "string", "pattern": "^[a-z0-9.-]{3,63}$" },
        "region": { "type": "string", "pattern": "^[a-z]{2}-[a-z]+-\\d$" },
        "role": { "type": "string", "pattern": "^arn:aws:iam::\\d{12}:role/[\\w+=,.@-]+$" }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "domain", "name", "origin", "gmina", "page", "detect", "watch", "zone", "extract", "validate"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "domain": { "enum": ["waste"] },
          "name": { "type": "string", "minLength": 1 },
          "origin": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "gmina": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "teryt"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "teryt": { "type": "string", "pattern": "^\\d{7}$" }
            }
          },
          "page": { "type": "string", "pattern": "^(https://|http://127\\.0\\.0\\.1:\\d+/)" },
          "detect": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "site", "file"],
            "properties": {
              "type": { "enum": ["wp-media", "wp-post-files"] },
              "site": { "type": "string", "pattern": "^(https://[^/]+|http://127\\.0\\.0\\.1:\\d+)$" },
              "parent": { "type": "integer", "minimum": 1 },
              "postSearch": { "type": "string", "minLength": 1 },
              "postTitle": { "type": "string", "minLength": 1 },
              "file": { "type": "string", "minLength": 1 }
            }
          },
          "watch": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["url", "links"],
              "properties": {
                "url": { "type": "string", "pattern": "^(https://|http://127\\.0\\.0\\.1:\\d+/)" },
                "links": { "type": "string", "minLength": 1 },
                "ignore": { "type": "array", "items": { "type": "string", "pattern": "^(https://|http://127\\.0\\.0\\.1:\\d+/)" } }
              }
            }
          },
          "zone": { "type": "string", "pattern": "\\{sector\\}" },
          "extract": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
              "type": { "enum": ["gmina-pdf-text", "miasto-jpg-vision"] }
            }
          },
          "validate": {
            "type": "array",
            "items": { "enum": ["year", "weekday", "counts", "villages", "streets"] }
          },
          "aliases": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        }
      }
    },
    "archived": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "origin", "fetched", "sha256"],
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "origin": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "fetched": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "url": { "type": "string", "pattern": "^(https://|http://127\\.0\\.0\\.1:\\d+/)" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
